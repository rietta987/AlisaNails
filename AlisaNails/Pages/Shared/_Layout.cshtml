<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    @{
        var description = ViewData["Description"] as string ?? "";
    }
    <meta name="description" content="@description">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Caveat:wght@600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

    <header>
        <div class="header-inner">
            <div class="logo">Алиса<span>.</span></div>
            <nav>
                <a href="#about">Обо мне</a>
                <a href="#gallery">Работы</a>
                <a href="#services">Услуги</a>
                <a href="#steps">Запись</a>
                <a href="#contacts">Контакты</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer>
        <p>© @DateTime.Now.Year Алиса — мастер маникюра · Сделано с <span class="heart">♥</span> и 🐾</p>
    </footer>

</body>
</html>